# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# Resend (https://resend.com) API key used by src/app/api/contact/route.ts
RESEND_API_KEY=

# The verified sending address/domain configured in your Resend account.
# Must be on a domain you have verified with Resend — do not use a
# placeholder or unverified domain, sends will be rejected or fail
# deliverability checks.
CONTACT_FROM_EMAIL=enquiries@dzmarketingsolutions.com

# Inbox that should receive new website enquiries.
CONTACT_EMAIL=contactdzmarketingsolutions@gmail.com
